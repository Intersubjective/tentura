# Dart-defines for the wasm mode of the web integration tests
# (TENTURA_WEB_E2E_WASM=1 scripts/run_client_integration_web_local.sh).
#
# Same as integration-web.env, except that the browser opens the app through
# the local Caddy HTTPS origin (Caddyfile.local, LOCAL_ROOT_SPLIT=off), which
# proxies app paths to flutter drive's dev server on localhost:8888, sends
# COOP/COEP (multi-threaded skwasm needs a cross-origin isolated page) and
# routes the API, WebSocket and /_qa paths to the local backend — so SERVER_NAME
# and WS_SERVER_NAME are that origin. No secrets here: the runner passes
# QA_AUTH_TOKEN from the repo-root .env as a separate --dart-define.
SERVER_NAME=https://dev.lvh.me:9443
WS_SERVER_NAME=https://dev.lvh.me:9443
IMAGE_SERVER=http://localhost:9000/tentura
GOOGLE_MAPS_API_KEY=
